{
  "permissions": {
    "deny": [
      "Read(*.env)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)"
    ]
  },
  "enabledPlugins": {
    "git-helpers@dennistai": true,
    "tech-docs@dennistai": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-review.sh",
            "statusMessage": "檢查 commit 前是否已審查"
          }
        ]
      }
    ]
  }
}
