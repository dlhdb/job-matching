      },
      "JobList": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "type": "array",
            "title": "Jobs"
          }
        },
        "type": "object",
        "required": [
          "jobs"
        ],
        "title": "JobList"
      },
      "PreviewOut": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobFields"
            },
            "type": "array",
            "title": "Jobs"
          },
          "new_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "New Codes",
            "description": "職缺資料庫裡還沒有的職缺代碼"
          },
          "found": {
            "type": "integer",
            "title": "Found"
          },
          "stopped": {
            "type": "boolean",
            "title": "Stopped"
          }
        },
        "type": "object",
        "required": [
          "jobs",
          "new_codes",
          "found",
          "stopped"
        ],
        "title": "PreviewOut"
      },
      "Running": {
        "properties": {
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchProgressOut"
              },
              {
                "$ref": "#/components/schemas/DetailProgressOut"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress",
            "description": "還沒送出第一個請求時為 null"
          },
          "stopping": {
            "type": "boolean",
            "title": "Stopping"
          }
        },
        "type": "object",
        "required": [
          "progress",
          "stopping"
        ],
        "title": "Running"
      },
      "SavedCodes": {
        "properties": {
          "codes": {
