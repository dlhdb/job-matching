          "特色標籤": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "特色標籤"
          },
          "職缺連結": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "職缺連結"
          },
          "公司連結": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "公司連結"
          },
          "首次出現時間": {
            "type": "string",
            "title": "首次出現時間"
          },
          "最後出現時間": {
            "type": "string",
            "title": "最後出現時間"
          }
        },
        "type": "object",
        "required": [
          "職缺代碼",
          "職缺名稱",
          "公司名稱",
          "產業類別",
          "地區",
          "薪資待遇",
          "薪資下限",
          "薪資上限",
          "更新日期",
          "應徵人數",
          "工作內容",
          "電腦專長",
          "科系要求",
          "特色標籤",
          "職缺連結",
          "公司連結",
          "首次出現時間",
          "最後出現時間"
        ],
        "title": "Job"
      },
