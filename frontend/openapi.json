          }
        },
        "type": "object",
        "required": [
          "codes"
        ],
        "title": "SavedCodes"
      },
      "SearchProgressOut": {
        "properties": {
          "stage": {
            "type": "string",
            "const": "search",
            "title": "Stage",
            "default": "search"
          },
          "keyword": {
            "type": "string",
            "title": "Keyword"
